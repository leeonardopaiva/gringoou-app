# =====================================================================
# Gringoou — modelo de variáveis de ambiente
#
# COMO USAR (são só 3 arquivos, todos fora do Git, exceto este):
#   .env.example  → este modelo (versionado). Nunca coloque segredos aqui.
#   .env.local    → SUA configuração local (Next.js carrega sozinho). É o único
#                   arquivo que você edita no dia a dia. Rode: npm run dev:local
#   .env          → só o banco LOCAL, usado pelo Prisma CLI (migrate/studio).
#                   Mantém o Prisma longe do banco de produção.
#   .env.vercel.production → só DATABASE_URL e DIRECT_URL de PRODUÇÃO, usados
#                   manualmente para rodar `prisma migrate deploy`. O Next não
#                   carrega este arquivo.
#
# PRODUÇÃO: as variáveis valem na Vercel (Settings → Environment Variables).
# Legenda: [OBRIGATÓRIA] precisa existir · [OPCIONAL] tem padrão · [LOCAL] só dev
# =====================================================================

# ---------- Banco de dados ----------
# [OBRIGATÓRIA] Neon (produção): DATABASE_URL = pooler, DIRECT_URL = conexão direta (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR-DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR-DATABASE?sslmode=require"

# ---------- Endereço do site e autenticação ----------
# [OBRIGATÓRIA] Em produção: https://gringoou.com
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# [OBRIGATÓRIA] Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"
NEXT_PUBLIC_EMAIL_AUTH_ENABLED="true"
NEXT_PUBLIC_PASSWORD_AUTH_ENABLED="true"
# [LOCAL] Login de desenvolvimento. SEMPRE "false" em produção.
DEV_AUTH_ENABLED="false"
NEXT_PUBLIC_DEV_AUTH_ENABLED="false"
EMAIL_TEST_ENABLED="false"
# [LOCAL] Descomente só para depurar o login (nunca em produção).
# NEXTAUTH_DEBUG="true"

# ---------- Administração ----------
# [OBRIGATÓRIA] Quem vira ADMIN ao entrar (e-mails separados por vírgula).
ADMIN_EMAILS="admin@seu-dominio.com,segundo-admin@seu-dominio.com"
# [OBRIGATÓRIA p/ gestão de planos] Administrador raiz: Integrações, Planos de anúncios e Cupons.
# Defina na Vercel; também precisa estar em ADMIN_EMAILS.
ROOT_ADMIN_EMAILS="voce@seu-dominio.com"

# ---------- E-mail (SMTP) ----------
# [OBRIGATÓRIA] Links de acesso, confirmações e avisos de moderação.
EMAIL_SERVER_HOST="smtp.seu-provedor.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="usuario-smtp"
EMAIL_SERVER_PASSWORD="senha-smtp"
EMAIL_FROM="Equipe Gringoou <no-reply@gringoou.com>"

# ---------- Imagens (Cloudinary) ----------
# [OBRIGATÓRIA] Envio de fotos e capas.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="replace-with-cloudinary-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="replace-with-unsigned-upload-preset"

# ---------- Pagamentos de anúncios (Stripe) ----------
# [OBRIGATÓRIA p/ anúncios pagos] Preços e pacotes NÃO ficam aqui: vêm do banco (Admin raiz › Planos).
STRIPE_SECRET_KEY="rk_test_replace-with-restricted-stripe-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_replace-with-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_replace-with-webhook-signing-secret"

# ---------- Limite de abusos (Upstash Redis) ----------
# [OPCIONAL] Sem isto o limite roda em memória (ok para local; em produção use o Upstash).
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"

# ---------- Mensagens em tempo real (Ably) ----------
# [OPCIONAL] https://ably.com/ (App → API Keys)
ABLY_API_KEY=""

# ---------- Mapas ----------
# [OPCIONAL] Token público do Mapbox.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
# O token deve ser PÚBLICO (pk.), nunca secreto (sk.). Restrinja por URL no painel do Mapbox.
# Usado no autocomplete de endereço e no mapa de área aproximada do Marketplace (mapbox-gl, estilo Standard).

# ---------- Inteligência artificial ----------
# [OPCIONAL] Assistente da comunidade. AI_PROVIDER = gemini ou claude.
AI_ASSISTANT_ENABLED="true"
AI_PROVIDER="gemini"
GEMINI_API_KEY="replace-with-server-side-gemini-key"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite"
ANTHROPIC_API_KEY="replace-with-server-side-anthropic-key"
CLAUDE_MODEL="claude-opus-5"
CLAUDE_EFFORT="low"

# ---------- Notícias ----------
# [OPCIONAL] Importação de notícias; cada chave ativa uma fonte quando preenchida.
NEWSDATA_API_KEY=""
NEWS_API_KEY=""

# ---------- Verificação por telefone (SMS / Twilio) ----------
# [OPCIONAL] Desativada por padrão.
PHONE_VERIFICATION_ENABLED="false"
NEXT_PUBLIC_PHONE_VERIFICATION_ENABLED="false"
TWILIO_ACCOUNT_SID="ACreplace-with-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_FROM_NUMBER="+17372508034"
# Países aceitos (ISO2, vírgula). Vazio/comentado = padrão: EUA, Canadá e Europa.
# PHONE_ALLOWED_COUNTRIES="US,CA,GB,DE,FR"
# Números isentos do bloqueio, para testes (E.164, vírgula).
PHONE_BYPASS_NUMBERS="+5500000000000"
# [LOCAL] Imprime o código no terminal em vez de enviar SMS. Nunca em produção.
PHONE_SMS_DEV_MODE="false"

# ---------- Acesso e lançamento ----------
MAINTENANCE_MODE="false"
REGISTRATION_ENABLED="true"
ADS_CHECKOUT_ENABLED="true"
# Portão de pré-lançamento (código só no servidor; nunca com NEXT_PUBLIC_).
PRE_LAUNCH_GATE_ENABLED="false"
PRE_LAUNCH_ACCESS_CODE=""
# Beta fechado e cadastro por convite (server-side).
PRIVATE_BETA_ENABLED="false"
INVITE_ONLY_REGISTRATION="false"

# ---------- Restrição por país (middleware) ----------
# Bloqueio por lista (desligado por padrão).
GEO_RESTRICTION_ENABLED="false"
GEO_BLOCKED_COUNTRIES="BR,AR,CL,CO,PE,VE,UY,PY,BO,EC,GY,SR"
# Modo por lista de permitidos (alternativo): descomente para usar.
# GEO_BLOCK_ENABLED="true"
# GEO_ALLOWED_COUNTRIES="US,CA"
# IPs fixos que nunca são bloqueados e chave para liberar o seu navegador (/api/geo-bypass?key=...).
GEO_BYPASS_IPS=""
GEO_BYPASS_KEY="replace-with-random-hex-key"

# ---------- Monitoramento (Sentry) ----------
# [OPCIONAL] Sem DSN o Sentry fica desativado. Token/org/projeto servem para enviar source maps no build.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="0.1"
