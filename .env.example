DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/YOUR-DATABASE?sslmode=require"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="true"
NEXT_PUBLIC_EMAIL_AUTH_ENABLED="true"
NEXT_PUBLIC_PASSWORD_AUTH_ENABLED="true"
DEV_AUTH_ENABLED="false"
NEXT_PUBLIC_DEV_AUTH_ENABLED="false"
NEXT_PUBLIC_USE_MOCKS="false"
EMAIL_TEST_ENABLED="false"
MAINTENANCE_MODE="false"
# Temporary pre-launch access gate. When PRE_LAUNCH_GATE_ENABLED is not "true"
# (or PRE_LAUNCH_ACCESS_CODE is empty) the app behaves exactly as before.
# PRE_LAUNCH_ACCESS_CODE is server-side only: never prefix it with NEXT_PUBLIC_.
PRE_LAUNCH_GATE_ENABLED="false"
PRE_LAUNCH_ACCESS_CODE=""
REGISTRATION_ENABLED="true"
AI_ASSISTANT_ENABLED="true"
ADS_CHECKOUT_ENABLED="true"
# Private Beta: quando ativo, aplica as restrições configuradas abaixo.
PRIVATE_BETA_ENABLED="false"
# Exige convite para novos cadastros (server-side). O flag público controla a UI.
INVITE_ONLY_REGISTRATION="false"
NEXT_PUBLIC_INVITE_ONLY_REGISTRATION="false"
# Restrição geográfica por lista de bloqueio (ex.: América do Sul).
GEO_RESTRICTION_ENABLED="false"
GEO_BLOCKED_COUNTRIES="BR,AR,CL,CO,PE,VE,UY,PY,BO,EC,GY,SR"
# Notícias: provedor Google News RSS habilitado por padrão. Desative com "false".
# Antes do uso comercial, verificar licenciamento do feed.
NEWS_GOOGLE_RSS_ENABLED="true"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE="0.1"
