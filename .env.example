# Verificacao por telefone (SMS via Twilio). Desativada por padrao ate integrar a API.
PHONE_VERIFICATION_ENABLED="false"
NEXT_PUBLIC_PHONE_VERIFICATION_ENABLED="false"
# Twilio Messages API (codigo de verificacao por SMS). FROM = numero Twilio de envio.
TWILIO_ACCOUNT_SID="ACreplace-with-twilio-account-sid"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
TWILIO_FROM_NUMBER="+17372508034"

# Paises aceitos para o telefone (ISO2, separados por virgula). Padrao: US, CA e Europa.
# PHONE_ALLOWED_COUNTRIES="US,CA,GB,DE,FR"  (deixe comentado para usar o padrao: US, CA e Europa)
# Numeros isentos do bloqueio, para testes do desenvolvedor (E.164, separados por virgula).
PHONE_BYPASS_NUMBERS="+5500000000000"

# Modo local: imprime o codigo no terminal em vez de enviar SMS. Nunca vale em producao.
PHONE_SMS_DEV_MODE="false"

# Controle de acesso por pais (middleware). Desligado por padrao.
# GEO_BLOCK_ENABLED="true"
# Excecoes: IPs fixos que nunca sao bloqueados (separados por virgula).
GEO_BYPASS_IPS=""
PHONE_ALLOWED_COUNTRIES=""
# Chave para liberar o seu navegador: /api/geo-bypass?key=<GEO_BYPASS_KEY>
GEO_BYPASS_KEY="replace-with-random-hex-key"
