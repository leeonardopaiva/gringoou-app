EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="usuario-smtp"
EMAIL_SERVER_PASSWORD="senha-smtp"
EMAIL_FROM="Equipe Gringoou <no-reply@gringoou.com>"
ADMIN_EMAILS="admin@seu-dominio.com,segundo-admin@seu-dominio.com"
GEMINI_API_KEY="replace-with-server-side-gemini-key"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODELS="gemini-3.5-flash-lite"
AI_PROVIDER="gemini"
ANTHROPIC_API_KEY="replace-with-server-side-anthropic-key"
