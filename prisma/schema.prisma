generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  BUSINESS_OWNER
  COMPANY
  MODERATOR
  ADMIN
}

enum CommunityGroupReportReason {
  MISINFORMATION
  VIOLENCE
  HATE_SPEECH
  ILLEGAL_GOODS_SERVICES
  SEXUALLY_EXPLICIT
  UNMODERATED
  IMPERSONATION
}

enum CommunityGroupReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum TimeAbroad {
  LESS_THAN_ONE_YEAR
  ONE_TO_THREE_YEARS
  THREE_TO_FIVE_YEARS
  MORE_THAN_FIVE_YEARS
}

enum BusinessStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
}

enum BusinessMemberRole {
  OWNER
  MANAGER
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CANCELED
}

enum VisibilityScope {
  GLOBAL
  USER_REGION
  SPECIFIC_REGION
}

enum CommunityPostStatus {
  PUBLISHED
  PENDING_REVIEW
  REMOVED
}

enum ReactionType {
  LIKE
}

enum SuggestionCategory {
  FUNCTIONALITY
  IMPROVEMENT
}

enum SuggestionStatus {
  NEW
  REVIEWED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CommunityGroupMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityGroupMembershipStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum BannerType {
  LINK
  REGISTRATION
}

enum BannerPlacement {
  HOME
  FEED
  BOTH
}

enum AdCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum AdObjective {
  TRAFFIC
  LEAD
  AWARENESS
}

enum AdBillingMode {
  FLAT
  CPC
  CPM
  CPL
}

enum AdGoal {
  WHATSAPP
  EXTERNAL_URL
  MARKETPLACE
}

enum AdPlan {
  BRONZE
  SILVER
  GOLD
}

enum AdModerationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AdPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdAccountRole {
  BUSINESS_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum MarketplaceStatus {
  PENDING_REVIEW
  ACTIVE
  SOLD
  UNAVAILABLE
  REMOVED
  REJECTED
}

enum MarketplaceCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

model User {
  id                        String                     @id @default(cuid())
  name                      String?
  username                  String?                    @unique
  email                     String?                    @unique
  passwordHash              String?
  emailVerified             DateTime?
  emailVerificationRequired Boolean                    @default(false)
  image                     String?
  coverImageUrl             String?
  bio                       String?
  interests                 String[]                   @default([])
  profileObjective          String?
  adsPersonalizationEnabled Boolean                    @default(true)
  galleryUrls               String[]                   @default([])
  role                      UserRole                   @default(USER)
  phone                     String?
  phoneVerifiedAt           DateTime?
  phoneCountry              String?
  accessCountry             String?
  locationLabel             String?
  regionKey                 String?
  referredById              String?
  onboardingCompleted       Boolean                    @default(false)
  gender                    Gender?
  age                       Int?
  timeAbroad                TimeAbroad?
  birthCity                 String?
  recruiterVerified         Boolean                    @default(false)
  isAdvertiser              Boolean                    @default(false)
  marketingEmailsOptOut     Boolean                    @default(false)
  preferredLanguage         String                     @default("pt-BR")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  accounts                  Account[]
  adCharges                 AdCharge[]
  adImpressions             AdImpression[]
  adAccountMemberships      AdAccountUser[]
  createdAds                Banner[]                   @relation("AdCreator")
  approvedAds               Banner[]                   @relation("AdApprover")
  sessions                  Session[]
  businessMemberships       BusinessMember[]
  createdBusinesses         Business[]                 @relation("BusinessCreator")
  createdEvents             Event[]                    @relation("EventCreator")
  createdJobs               Job[]                      @relation("JobCreator")
  createdHousing            Housing[]                  @relation("HousingCreator")
  communityPosts            CommunityPost[]            @relation("CommunityPostAuthor")
  postComments              PostComment[]              @relation("PostCommentAuthor")
  jobComments               JobComment[]
  housingComments           HousingComment[]
  postReactions             PostReaction[]             @relation("PostReactionAuthor")
  postReports               PostReport[]               @relation("PostReportAuthor")
  postPreferences           CommunityPostPreference[]
  mutedUsers                UserMute[]                 @relation("UserMuteSource")
  mutedByUsers              UserMute[]                 @relation("UserMuteTarget")
  emailChangeTokens         EmailChangeToken[]
  passwordResetTokens       PasswordResetToken[]
  suggestions               Suggestion[]
  businessFavorites         BusinessFavorite[]
  eventFavorites            EventFavorite[]
  businessRatings           BusinessRating[]
  eventRatings              EventRating[]
  analyticsEvents           AnalyticsEvent[]
  bannerRegistrations       BannerRegistration[]
  sentFriendRequests        FriendRequest[]            @relation("FriendRequestSender")
  receivedFriendRequests    FriendRequest[]            @relation("FriendRequestRecipient")
  createdGroups             CommunityGroup[]           @relation("CommunityGroupCreator")
  groupMemberships          CommunityGroupMember[]
  groupReports              CommunityGroupReport[]     @relation("CommunityGroupReportAuthor")
  reviewedGroupReports      CommunityGroupReport[]     @relation("CommunityGroupReportReviewer")
  referredBy                User?                      @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                 User[]                     @relation("UserReferrals")
  phoneVerificationCodes    PhoneVerificationCode[]
  marketplaceItems          MarketplaceItem[]          @relation("MarketplaceItemCreator")
  newsArticles              NewsArticle[]              @relation("NewsArticleAuthor")
  newsLikes                 NewsArticleLike[]
  messagePolicy             MessagePolicy              @default(EVERYONE)
  newsComments              NewsComment[]              @relation("NewsCommentAuthor")
  newsCommentReports        NewsCommentReport[]        @relation("NewsCommentReporter")
  conversationStates        ConversationState[]
  blocksMade                UserBlock[]                @relation("UserBlocksMade")
  blocksReceived            UserBlock[]                @relation("UserBlocksReceived")
  messageReportsMade        MessageReport[]            @relation("MessageReportAuthor")
  messageReportsReceived    MessageReport[]            @relation("MessageReportTarget")
  messageReportsReviewed    MessageReport[]            @relation("MessageReportReviewer")
  marketplaceFavorites      MarketplaceFavorite[]      @relation("MarketplaceFavoriteUser")
  createdInvites            Invite[]                   @relation("InviteCreator")
  revokedInvites            Invite[]                   @relation("InviteRevoker")
  inviteUsages              InviteUsage[]              @relation("InviteUsageUser")
  buyerConversations        MarketplaceConversation[]  @relation("ConversationBuyer")
  sellerConversations       MarketplaceConversation[]  @relation("ConversationSeller")
  sentMessages              MarketplaceMessage[]       @relation("MessageSender")
  marketplaceModerationLogs MarketplaceModerationLog[] @relation("MarketplaceModerator")

  @@index([referredById, createdAt])
}

model Job {
  id             String       @id @default(cuid())
  title          String
  company        String
  description    String       @db.Text
  employmentType String
  locationLabel  String
  countryCode    String       @default("US")
  regionKey      String?
  salary         String?
  contactUrl     String?
  imageUrl       String?
  galleryUrls    String[]     @default([])
  businessId     String?
  isActive       Boolean      @default(true)
  createdById    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      User         @relation("JobCreator", fields: [createdById], references: [id], onDelete: Cascade)
  business       Business?    @relation("JobBusiness", fields: [businessId], references: [id], onDelete: SetNull)
  comments       JobComment[]

  @@index([isActive, createdAt])
  @@index([isActive, regionKey, createdAt])
  @@index([createdById, createdAt])
  @@index([businessId, createdAt])
}

model Housing {
  id            String           @id @default(cuid())
  title         String
  description   String           @db.Text
  propertyType  String
  locationLabel String
  regionKey     String?
  price         String
  imageUrl      String?
  galleryUrls   String[]         @default([])
  contactUrl    String?
  isActive      Boolean          @default(true)
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdBy     User             @relation("HousingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  comments      HousingComment[]

  @@index([isActive, createdAt])
  @@index([isActive, regionKey, createdAt])
  @@index([createdById, createdAt])
}

model Region {
  key                       String           @id
  label                     String           @unique
  city                      String
  state                     String
  countryCode               String           @default("US")
  lat                       Float
  lng                       Float
  aliases                   String[]         @default([])
  isActive                  Boolean          @default(true)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  banners                   Banner[]
  communityGroups           CommunityGroup[]
  businessVisibilityTargets Business[]       @relation("BusinessVisibilityRegion")
  eventVisibilityTargets    Event[]          @relation("EventVisibilityRegion")

  @@index([isActive, label])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String
  newEmail  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, newEmail])
  @@index([newEmail, expiresAt])
}

model Business {
  id                  String                 @id @default(cuid())
  name                String
  slug                String                 @unique
  category            String
  description         String?
  phone               String?
  whatsapp            String?
  website             String?
  instagram           String?
  address             String
  locationLabel       String
  regionKey           String
  visibilityScope     VisibilityScope        @default(USER_REGION)
  visibilityRegionKey String?
  imageUrl            String?
  galleryUrls         String[]               @default([])
  ratingAverage       Float                  @default(0)
  ratingCount         Int                    @default(0)
  status              BusinessStatus         @default(PENDING_REVIEW)
  ownershipVerifiedAt DateTime?
  createdById         String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  createdBy           User                   @relation("BusinessCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members             BusinessMember[]
  visibilityRegion    Region?                @relation("BusinessVisibilityRegion", fields: [visibilityRegionKey], references: [key], onDelete: SetNull)
  favorites           BusinessFavorite[]
  ratings             BusinessRating[]
  communityPosts      CommunityPost[]        @relation("CommunityPostBusinessAuthor")
  events              Event[]                @relation("EventBusiness")
  jobs                Job[]                  @relation("JobBusiness")
  adAccount           AdAccount?
  slugRedirects       BusinessSlugRedirect[]

  @@index([status, regionKey])
  @@index([category, regionKey])
  @@index([visibilityScope, visibilityRegionKey])
}

model BusinessSlugRedirect {
  slug       String   @id
  businessId String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessMember {
  id         String             @id @default(cuid())
  businessId String
  userId     String
  role       BusinessMemberRole @default(OWNER)
  createdAt  DateTime           @default(now())
  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

model Event {
  id                  String          @id @default(cuid())
  title               String
  slug                String          @unique
  description         String
  venueName           String
  category            String          @default("Outros")
  startsAt            DateTime
  endsAt              DateTime?
  locationLabel       String
  regionKey           String
  visibilityScope     VisibilityScope @default(USER_REGION)
  visibilityRegionKey String?
  externalUrl         String?
  imageUrl            String?
  galleryUrls         String[]        @default([])
  ratingAverage       Float           @default(0)
  ratingCount         Int             @default(0)
  status              EventStatus     @default(PENDING_REVIEW)
  ownershipVerifiedAt DateTime?
  businessId          String?
  createdById         String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  createdBy           User            @relation("EventCreator", fields: [createdById], references: [id], onDelete: Cascade)
  business            Business?       @relation("EventBusiness", fields: [businessId], references: [id], onDelete: SetNull)
  visibilityRegion    Region?         @relation("EventVisibilityRegion", fields: [visibilityRegionKey], references: [key], onDelete: SetNull)
  favorites           EventFavorite[]
  ratings             EventRating[]

  @@index([status, regionKey, startsAt])
  @@index([visibilityScope, visibilityRegionKey, startsAt])
  @@index([businessId, startsAt])
  @@index([category, regionKey, startsAt])
}

model CommunityPost {
  id               String                    @id @default(cuid())
  content          String                    @db.Text
  imageUrl         String?
  externalUrl      String?
  status           CommunityPostStatus       @default(PUBLISHED)
  authorId         String
  businessAuthorId String?
  groupId          String?
  regionKey        String
  locationLabel    String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  author           User                      @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  businessAuthor   Business?                 @relation("CommunityPostBusinessAuthor", fields: [businessAuthorId], references: [id], onDelete: SetNull)
  group            CommunityGroup?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  comments         PostComment[]
  reactions        PostReaction[]
  reports          PostReport[]
  preferences      CommunityPostPreference[]

  @@index([status, regionKey, createdAt])
  @@index([businessAuthorId, createdAt])
  @@index([groupId, status, createdAt])
}

model PostComment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String        @db.Text
  isHidden  Boolean       @default(false)
  hiddenAt  DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation("PostCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("PostCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("PostCommentReplies")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
}

model JobComment {
  id        String       @id @default(cuid())
  jobId     String
  authorId  String
  content   String       @db.Text
  parentId  String?
  isHidden  Boolean      @default(false)
  hiddenAt  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  job       Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    JobComment?  @relation("JobCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   JobComment[] @relation("JobCommentReplies")

  @@index([jobId, createdAt])
  @@index([parentId, createdAt])
}

model HousingComment {
  id        String           @id @default(cuid())
  housingId String
  authorId  String
  content   String           @db.Text
  parentId  String?
  isHidden  Boolean          @default(false)
  hiddenAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  housing   Housing          @relation(fields: [housingId], references: [id], onDelete: Cascade)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    HousingComment?  @relation("HousingCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   HousingComment[] @relation("HousingCommentReplies")

  @@index([housingId, createdAt])
  @@index([parentId, createdAt])
}

model PostReaction {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  type      ReactionType  @default(LIKE)
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation("PostReactionAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([postId, authorId, type])
}

model PostReport {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  reason    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation("PostReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([postId, authorId])
}

model AdAccount {
  id               String          @id @default(cuid())
  name             String
  websiteUrl       String?
  phone            String?
  businessAddress  String?
  businessCategory String?
  subcategories    String[]
  country          String          @default("US")
  currency         String          @default("USD")
  timezone         String          @default("UTC")
  isAgency         Boolean         @default(false)
  logoUrl          String?
  useWebsitePhotos Boolean         @default(true)
  businessId       String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  business         Business?       @relation(fields: [businessId], references: [id], onDelete: SetNull)
  users            AdAccountUser[]
  banners          Banner[]

  @@index([name])
  @@index([businessCategory])
}

model AdAccountUser {
  id          String        @id @default(cuid())
  adAccountId String
  userId      String
  role        AdAccountRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  adAccount   AdAccount     @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, userId])
  @@index([userId, createdAt])
}

model Banner {
  id                  String               @id @default(cuid())
  name                String
  imageUrl            String
  type                BannerType           @default(LINK)
  placement           BannerPlacement      @default(HOME)
  targetUrl           String?
  regionKey           String?
  isActive            Boolean              @default(false)
  campaignStatus      AdCampaignStatus     @default(DRAFT)
  objective           AdObjective          @default(TRAFFIC)
  billingMode         AdBillingMode        @default(FLAT)
  paymentStatus       AdPaymentStatus      @default(PENDING)
  adAccountId         String?
  createdById         String?
  goal                AdGoal?
  headline            String?
  description         String?              @db.Text
  ctaLabel            String?
  whatsappNumber      String?
  marketplaceItemId   String?
  plan                AdPlan?
  durationMonths      Int?
  contractAmountCents Int?
  moderationStatus    AdModerationStatus   @default(DRAFT)
  submittedAt         DateTime?
  approvedAt          DateTime?
  approvedById        String?
  rejectionReason     String?              @db.Text
  targetInterests     String[]             @default([])
  targetKeywords      String[]             @default([])
  targetCategories    String[]             @default([])
  startsAt            DateTime?
  endsAt              DateTime?
  dailyBudgetCents    Int?
  totalBudgetCents    Int?
  bidCents            Int                  @default(0)
  spentCents          Int                  @default(0)
  checkoutUrl         String?
  paymentProvider     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  region              Region?              @relation(fields: [regionKey], references: [key], onDelete: SetNull)
  adAccount           AdAccount?           @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("AdCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy          User?                @relation("AdApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  registrations       BannerRegistration[]
  impressions         AdImpression[]
  charges             AdCharge[]
  payments            AdPayment[]

  @@index([isActive, regionKey, updatedAt])
  @@index([campaignStatus, startsAt, endsAt])
  @@index([paymentStatus, updatedAt])
  @@index([adAccountId, updatedAt])
  @@index([createdById, updatedAt])
  @@index([moderationStatus, paymentStatus, updatedAt])
}

model AdPayment {
  id                String          @id @default(cuid())
  bannerId          String
  provider          String          @default("STRIPE")
  providerSessionId String?         @unique
  providerPaymentId String?         @unique
  amountCents       Int
  currency          String          @default("USD")
  status            AdPaymentStatus @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paidAt            DateTime?
  banner            Banner          @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId, createdAt])
  @@index([status, updatedAt])
}

model AdCharge {
  id          String        @id @default(cuid())
  bannerId    String
  userId      String?
  amountCents Int
  billingMode AdBillingMode
  sourceType  String
  createdAt   DateTime      @default(now())
  banner      Banner        @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bannerId, createdAt])
  @@index([userId, createdAt])
}

model AdImpression {
  id            String          @id @default(cuid())
  bannerId      String
  userId        String?
  placement     BannerPlacement
  sourcePath    String?
  sourceSection String?
  regionKey     String?
  matchedBy     String[]        @default([])
  createdAt     DateTime        @default(now())
  banner        Banner          @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([bannerId, createdAt])
  @@index([userId, createdAt])
  @@index([placement, createdAt])
}

model BannerRegistration {
  id            String   @id @default(cuid())
  bannerId      String
  userId        String
  name          String?
  email         String?
  phone         String?
  regionKey     String?
  locationLabel String?
  createdAt     DateTime @default(now())
  banner        Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bannerId, userId])
  @@index([bannerId, createdAt])
  @@index([userId, createdAt])
}

model BusinessFavorite {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId, createdAt])
}

model EventFavorite {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model BusinessRating {
  id         String   @id @default(cuid())
  businessId String
  userId     String
  stars      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([businessId, updatedAt])
}

model EventRating {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, updatedAt])
}

model FriendRequest {
  id          String              @id @default(cuid())
  requesterId String
  recipientId String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  requester   User                @relation("FriendRequestSender", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([requesterId, recipientId])
  @@index([recipientId, status, createdAt])
}

model CommunityGroup {
  id            String                 @id @default(cuid())
  name          String
  slug          String                 @unique
  description   String?
  imageUrl      String?
  coverImageUrl String?
  category      String?
  regionKey     String?
  countryCode   String                 @default("US")
  isPublic      Boolean                @default(true)
  createdById   String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  createdBy     User                   @relation("CommunityGroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  region        Region?                @relation(fields: [regionKey], references: [key], onDelete: SetNull)
  members       CommunityGroupMember[]
  posts         CommunityPost[]
  reports       CommunityGroupReport[]

  @@index([isPublic, createdAt])
  @@index([regionKey, createdAt])
  @@index([countryCode, isPublic, createdAt])
  @@index([createdById, createdAt])
}

model CommunityGroupMember {
  id        String                         @id @default(cuid())
  groupId   String
  userId    String
  role      CommunityGroupMemberRole       @default(MEMBER)
  status    CommunityGroupMembershipStatus @default(APPROVED)
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt
  group     CommunityGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, createdAt])
  @@index([groupId, createdAt])
  @@index([groupId, status, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model CommunityGroupReport {
  id           String                     @id @default(cuid())
  groupId      String
  reporterId   String
  reason       CommunityGroupReportReason
  status       CommunityGroupReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  group        CommunityGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  reporter     User                       @relation("CommunityGroupReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?                      @relation("CommunityGroupReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([groupId, reporterId])
  @@index([status, createdAt])
  @@index([groupId, createdAt])
}

model CommunityPostPreference {
  id           String        @id @default(cuid())
  postId       String
  userId       String
  isSaved      Boolean       @default(false)
  isInterested Boolean       @default(false)
  isHidden     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, isSaved, updatedAt])
}

model UserMute {
  id          String   @id @default(cuid())
  userId      String
  mutedUserId String
  createdAt   DateTime @default(now())
  user        User     @relation("UserMuteSource", fields: [userId], references: [id], onDelete: Cascade)
  mutedUser   User     @relation("UserMuteTarget", fields: [mutedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, mutedUserId])
  @@index([mutedUserId])
}

model Suggestion {
  id        String             @id @default(cuid())
  category  SuggestionCategory
  message   String             @db.Text
  status    SuggestionStatus   @default(NEW)
  userId    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model AnalyticsEvent {
  id            String   @id @default(cuid())
  type          String
  targetType    String
  targetKey     String
  label         String
  sourcePath    String?
  sourceSection String?
  regionKey     String?
  userId        String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([targetType, targetKey, createdAt])
  @@index([userId, createdAt])
  @@index([sourceSection, createdAt])
}

enum WaitlistStatus {
  PENDING
  INVITED
  ACTIVE
}

enum InviteStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

// Pre-launch waiting list captured from the institutional landing page.
// Access is released gradually by moving entries from PENDING to INVITED.
model WaitlistEntry {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String?
  country   String?
  status    WaitlistStatus @default(PENDING)
  invitedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  invites   Invite[]

  @@index([status, createdAt])
}

// One-time SMS codes. Only an HMAC of the code is stored, never the code itself.
model PhoneVerificationCode {
  id        String    @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, phone, createdAt])
}

model Invite {
  id              String         @id @default(cuid())
  codeHash        String         @unique
  status          InviteStatus   @default(ACTIVE)
  email           String?
  usageLimit      Int            @default(1)
  usedCount       Int            @default(0)
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdById     String
  revokedById     String?
  waitlistEntryId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  createdBy       User           @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)
  revokedBy       User?          @relation("InviteRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  waitlistEntry   WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  usages          InviteUsage[]

  @@index([status, createdAt])
  @@index([email, status])
  @@index([createdById, createdAt])
  @@index([waitlistEntryId])
}

model InviteUsage {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String
  createdAt DateTime @default(now())
  invite    Invite   @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user      User     @relation("InviteUsageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inviteId, userId])
  @@index([userId, createdAt])
  @@index([inviteId, createdAt])
}

model MarketplaceItem {
  id               String                     @id @default(cuid())
  title            String
  description      String                     @db.Text
  category         String
  priceCents       Int?
  isFree           Boolean                    @default(false)
  condition        MarketplaceCondition       @default(GOOD)
  locationLabel    String
  regionKey        String
  imageUrl         String?
  galleryUrls      String[]                   @default([])
  status           MarketplaceStatus          @default(PENDING_REVIEW)
  createdById      String
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  latitude         Float?
  longitude        Float?
  moderationReason String?                    @db.Text
  moderatedById    String?
  moderatedAt      DateTime?
  moderationLogs   MarketplaceModerationLog[]
  createdBy        User                       @relation("MarketplaceItemCreator", fields: [createdById], references: [id], onDelete: Cascade)
  favorites        MarketplaceFavorite[]
  conversations    MarketplaceConversation[]

  @@index([status, regionKey, createdAt])
  @@index([status, category, regionKey, createdAt])
  @@index([createdById, createdAt])
}

model MarketplaceFavorite {
  id        String          @id @default(cuid())
  itemId    String
  userId    String
  createdAt DateTime        @default(now())
  item      MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User            @relation("MarketplaceFavoriteUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId, createdAt])
}

model MarketplaceConversation {
  id            String                        @id @default(cuid())
  /// Nulo em conversas diretas entre duas pessoas (sem anúncio).
  itemId        String?
  buyerId       String
  sellerId      String
  status        MarketplaceConversationStatus @default(ACTIVE)
  /// PENDING: mensagem direta de quem o destinatário não aceita receber direto; aguarda aceitar/excluir.
  requestStatus ConversationRequestStatus     @default(ACCEPTED)
  lastMessageAt DateTime?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  item          MarketplaceItem?              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyer         User                          @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller        User                          @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages      MarketplaceMessage[]
  reports       MessageReport[]
  states        ConversationState[]

  @@unique([itemId, buyerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
  @@index([itemId])
}

enum MarketplaceConversationStatus {
  ACTIVE
  ARCHIVED
}

/// Quem pode iniciar mensagem direta com a pessoa.
enum MessagePolicy {
  EVERYONE
  FRIENDS
  NOBODY
}

enum ConversationRequestStatus {
  ACCEPTED
  PENDING
}

/// Estado da conversa para cada participante (arquivar, silenciar, excluir só para si).
model ConversationState {
  id             String                  @id @default(cuid())
  conversationId String
  userId         String
  archivedAt     DateTime?
  mutedAt        DateTime?
  deletedAt      DateTime?
  conversation   MarketplaceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model MarketplaceMessage {
  id             String                  @id @default(cuid())
  conversationId String
  senderId       String
  content        String                  @db.Text
  readAt         DateTime?
  /// Apagada pelo autor: o texto deixa de aparecer, mas a linha fica para a moderação.
  deletedAt      DateTime?
  ablyMessageId  String?
  createdAt      DateTime                @default(now())
  conversation   MarketplaceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                    @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MarketplaceModerationLog {
  id          String          @id @default(cuid())
  itemId      String
  moderatorId String?
  decision    String
  reason      String?         @db.Text
  createdAt   DateTime        @default(now())
  item        MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  moderator   User?           @relation("MarketplaceModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([moderatorId])
}

enum NewsArticleStatus {
  DRAFT
  PUBLISHED
}

/// Notícia editorial curada por MODERATOR/ADMIN (sem integração automática com RSS/API).
model NewsArticle {
  id          String            @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String?
  category    String
  regionKey   String?
  source      String
  externalUrl String
  status      NewsArticleStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  author      User?             @relation("NewsArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  likes       NewsArticleLike[]
  comments    NewsComment[]

  @@index([status, publishedAt, id])
  @@index([status, regionKey, publishedAt])
  @@index([status, category, publishedAt])
  @@index([authorId, createdAt])
}

model NewsComment {
  id        String              @id @default(cuid())
  articleId String
  authorId  String
  content   String              @db.Text
  /// Oculto pela moderação (ou automaticamente após várias denúncias).
  isHidden  Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  article   NewsArticle         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User                @relation("NewsCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reports   NewsCommentReport[]

  @@index([articleId, createdAt])
  @@index([authorId])
}

model NewsCommentReport {
  commentId  String
  reporterId String
  createdAt  DateTime    @default(now())
  comment    NewsComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User        @relation("NewsCommentReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@id([commentId, reporterId])
  @@index([reporterId])
}

model NewsArticleLike {
  userId    String
  articleId String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
}

enum MessageReportReason {
  SPAM
  HARASSMENT
  SCAM
  INAPPROPRIATE
  OTHER
}

enum MessageReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

/// Bloqueio entre pessoas: quem bloqueia não recebe nem envia mensagens para a pessoa bloqueada.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

/// Denúncia de uma conversa direta ou de anúncio, revisada pela moderação.
model MessageReport {
  id             String                   @id @default(cuid())
  conversationId String?
  reporterId     String
  reportedUserId String
  reason         MessageReportReason
  details        String?
  status         MessageReportStatus      @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  conversation   MarketplaceConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  reporter       User                     @relation("MessageReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User                     @relation("MessageReportTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reviewedBy     User?                    @relation("MessageReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([reporterId, createdAt])
}
